/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=()

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=604800

/css/*
  Cache-Control: no-cache

/js/*
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache

/admin
  Cache-Control: no-store
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' https://accounts.google.com/gsi/style; img-src 'self' data: blob: https://*.googleusercontent.com; connect-src 'self' https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; font-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  X-Robots-Tag: noindex, nofollow

/admin/*
  Cache-Control: no-store
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' https://accounts.google.com/gsi/style; img-src 'self' data: blob: https://*.googleusercontent.com; connect-src 'self' https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; font-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  X-Robots-Tag: noindex, nofollow

/api/*
  X-Robots-Tag: noindex

/shop/*
  Cache-Control: no-cache

/shop
  Cache-Control: no-cache
